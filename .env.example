# ============================================================================
# POCKETSWAP — PRODUCTION ENVIRONMENT KEYS (.env)
# Copy this file to `.env` or paste these values in chat and I will wire them!
# ============================================================================

# 1. SUPABASE (Database, Auth, Real-Time Trade Chat & Image/Video Storage)
# Get from: https://supabase.com/dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# 2. MAPBOX (Optional — High-Traffic Commercial Real Street Map Tiles)
# Note: Free OpenStreetMap/CARTO street tiles work automatically if left blank!
# Get from: https://account.mapbox.com/access-tokens/
VITE_MAPBOX_ACCESS_TOKEN=
